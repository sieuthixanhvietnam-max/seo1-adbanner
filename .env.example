# ─── Backend ───────────────────────────────────────────────────
BACKEND_PORT=3001
# Chỉ dùng để khởi tạo mật khẩu lần đầu (sau đó mật khẩu băm bcrypt nằm trong DB, đổi trong admin).
# Quên mật khẩu: cd backend && node scripts/reset-admin-password.js
ADMIN_PASSWORD=your-password-here
ADMIN_TOKEN=your-long-secret-token-here
# Thời hạn phiên đăng nhập (giờ, mặc định 12)
SESSION_TTL_HOURS=12
BASE_URL=https://banners.aeseo1.com

# Cloudflare R2 (để trống = dùng local /uploads/)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=       # URL public của bucket R2 (vd https://pub-xxxx.r2.dev)
IMAGE_POOL_DOMAIN=img-pool.com

# Chu kỳ domain-checker (phút, mặc định 5)
DOMAIN_CHECK_INTERVAL_MINUTES=5

# ─── Admin UI ──────────────────────────────────────────────────
# (Next.js đọc từ .env.local trong thư mục admin)
# NEXT_PUBLIC_API_URL=https://banners.aeseo1.com
