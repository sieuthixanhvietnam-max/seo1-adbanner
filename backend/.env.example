# Server
PORT=3001
# Chỉ dùng để khởi tạo mật khẩu lần đầu (sau đó mật khẩu băm bcrypt nằm trong DB, đổi trong admin).
# Quên mật khẩu: cd backend && node scripts/reset-admin-password.js
ADMIN_PASSWORD=your-password-here
ADMIN_TOKEN=your-secret-token-here
# Thời hạn phiên đăng nhập (giờ, mặc định 12)
SESSION_TTL_HOURS=12

# URLs
BASE_URL=https://banners.aeseo1.com

# Cloudflare R2 (để trống = dùng local /uploads/)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=       # URL public của bucket R2 (vd https://pub-xxxx.r2.dev)

# Image domain pool
IMAGE_POOL_DOMAIN=img-pool.com

# Alias ảnh theo domain WordPress (chống footprint tên file): mỗi domain nhận tên file ngẫu nhiên riêng,
# dạng <banners|brands|toplist>/<slug>.<ext> (plugin WP chỉ xử lý đúng dạng này).
# off  = mọi domain trong cùng nhóm dùng chung alias (mặc định, an toàn)
# on   = mỗi domain 1 alias riêng (domain lấy từ ?domain= mà plugin tự gửi)
IMAGE_ALIAS_PER_DOMAIN=off
# Khi off: chỉ các domain này được alias riêng — dùng để thử nghiệm trên vài site trước khi bật hết
IMAGE_ALIAS_PILOT_DOMAINS=
# Trần số domain khác nhau (chặn nhồi domain giả); vượt trần thì domain mới dùng alias chung
IMAGE_ALIAS_MAX_DOMAINS=3000
# Biến thể byte riêng từng domain (encode lại + EXIF riêng, cache ở backend/data/variants). Mặc định off
IMAGE_VARIANTS=off

# Chu kỳ domain-checker (phút, mặc định 5)
DOMAIN_CHECK_INTERVAL_MINUTES=5

# Tự chuyển ảnh upload (jpg/png/gif) sang WebP. Đặt off để tắt
IMAGE_WEBP=on
IMAGE_WEBP_QUALITY=82
